{%- comment -%}
  Pagina catalogo con tab Libri / Stampe separati.
  Usa product.type oppure tags per distinguere:
    - Libri: product.type == 'Libro' OR tag 'libro'
    - Stampe: product.type == 'Stampa' OR product.type == 'Fine Art Print' OR tag 'stampa'
{%- endcomment -%}

{%- assign all_products = collection.products -%}

{%- comment -%} Definizione etichette con fallback robusto per evitare valori vuoti da Shopify Customizer {%- endcomment -%}
{%- assign tab_libri_label = section.settings.tab_libri_label -%}
{%- if tab_libri_label == blank -%}{%- assign tab_libri_label = 'Fumetti' -%}{%- endif -%}

{%- assign tab_stampe_label = section.settings.tab_stampe_label -%}
{%- if tab_stampe_label == blank -%}{%- assign tab_stampe_label = 'Stampe Artistiche' -%}{%- endif -%}

{%- comment -%} Separa i prodotti in due array {%- endcomment -%}
{%- assign libri = '' | split: '' -%}
{%- assign stampe = '' | split: '' -%}
{%- for p in all_products -%}
  {%- assign is_book = false -%}
  {%- if p.type != blank -%}
    {%- assign p_type_down = p.type | downcase -%}
    {%- if p_type_down contains 'libro' or p_type_down contains 'fumetto' or p_type_down contains 'albo' or p_type_down contains 'comic' or p_type_down contains 'book' -%}
      {%- assign is_book = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- if is_book == false -%}
    {%- if p.tags contains 'libro' or p.tags contains 'libri' or p.tags contains 'fumetto' or p.tags contains 'fumetti' or p.tags contains 'book' or p.tags contains 'books' -%}
      {%- assign is_book = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- if is_book -%}
    {%- assign libri = libri | concat: p -%}
  {%- else -%}
    {%- comment -%} Qualsiasi altra cosa (stampe, opere originali, quadri) va in Stampe Artistiche per evitare confusione {%- endcomment -%}
    {%- assign stampe = stampe | concat: p -%}
  {%- endif -%}
{%- endfor -%}

<div class="catalog-page" data-section-id="{{ section.id }}">

  <!-- Hero intestazione catalogo -->
  <div class="catalog-hero">
    <div class="container">
      <p class="catalog-hero-label">{{ section.settings.label | default: 'Catalogo' }}</p>
      <h1 class="catalog-hero-title">{{ collection.title | default: section.settings.title | default: 'Tutto il Catalogo' }}</h1>
      {%- if collection.description != blank -%}
        <p class="catalog-hero-desc">{{ collection.description | strip_html }}</p>
      {%- elsif section.settings.subtitle != blank -%}
        <p class="catalog-hero-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>

  <!-- Tab switcher -->
  <div class="catalog-tabs-wrapper">
    <div class="container">
      <div class="catalog-tabs" role="tablist" aria-label="Categorie catalogo">
        <button
          class="catalog-tab active"
          id="tab-libri"
          role="tab"
          aria-selected="true"
          aria-controls="panel-libri"
          data-tab="libri"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>{{ tab_libri_label }}</span>
          <span class="tab-count">{{ libri.size }}</span>
        </button>
        <button
          class="catalog-tab"
          id="tab-stampe"
          role="tab"
          aria-selected="false"
          aria-controls="panel-stampe"
          data-tab="stampe"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>{{ tab_stampe_label }}</span>
          <span class="tab-count">{{ stampe.size }}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Panel LIBRI -->
  <div
    class="catalog-panel active"
    id="panel-libri"
    role="tabpanel"
    aria-labelledby="tab-libri"
  >
    <div class="container">
      {%- if libri.size > 0 -%}
        <div class="catalog-section-intro">
          <p class="catalog-section-label">{{ tab_libri_label }}</p>
          <p class="catalog-section-desc">{{ section.settings.libri_desc | default: 'Storie a fumetti, romanzi visivi e racconti illustrati — ogni volume è un viaggio nei confini della coscienza.' }}</p>
        </div>

        <div class="catalog-grid catalog-grid--books">
          {%- for product in libri -%}
            {%- render 'product-card', product: product, layout: 'book' -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="catalog-empty">
          <div class="catalog-empty-icon">✦</div>
          <p class="catalog-empty-title">Nessun libro disponibile al momento</p>
          <p class="catalog-empty-sub">Torna presto — nuovi titoli in arrivo.</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Panel STAMPE -->
  <div
    class="catalog-panel"
    id="panel-stampe"
    role="tabpanel"
    aria-labelledby="tab-stampe"
    hidden
  >
    <div class="container">
      {%- if stampe.size > 0 -%}
        <div class="catalog-section-intro">
          <p class="catalog-section-label">{{ tab_stampe_label }}</p>
          <p class="catalog-section-desc">{{ section.settings.stampe_desc | default: "Stampe in edizione limitata su carta cotone. Ogni opera è numerata e firmata dall'autrice." }}</p>
        </div>

        <!-- Layout a griglia sfalsata per le stampe -->
        <div class="catalog-grid catalog-grid--prints">
          {%- for product in stampe -%}
            {%- render 'product-card', product: product, layout: 'print' -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="catalog-empty">
          <div class="catalog-empty-icon">✦</div>
          <p class="catalog-empty-title">Nessuna stampa disponibile al momento</p>
          <p class="catalog-empty-sub">Torna presto — nuove opere in arrivo.</p>
        </div>
      {%- endif -%}
    </div>
  </div>

</div>

<script>
(function () {
  const tabs = document.querySelectorAll('.catalog-tab');
  const panels = document.querySelectorAll('.catalog-panel');

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      const target = tab.getAttribute('data-tab');

      // Aggiorna tab
      tabs.forEach(function (t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      // Aggiorna panel
      panels.forEach(function (panel) {
        if (panel.id === 'panel-' + target) {
          panel.classList.add('active');
          panel.removeAttribute('hidden');
        } else {
          panel.classList.remove('active');
          panel.setAttribute('hidden', '');
        }
      });

      // Salva la tab attiva nell'URL senza ricaricare
      const url = new URL(window.location);
      url.searchParams.set('tab', target);
      window.history.replaceState({}, '', url);
    });
  });

  // Ripristina tab da URL (es. ?tab=stampe)
  const urlTab = new URLSearchParams(window.location.search).get('tab');
  if (urlTab) {
    const savedTab = document.querySelector('[data-tab="' + urlTab + '"]');
    if (savedTab) savedTab.click();
  }
})();
</script>

{% schema %}
{
  "name": "Catalogo con Tab",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etichetta sopra titolo",
      "default": "Catalogo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo (se non c'è collezione)",
      "default": "Tutto il Catalogo"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sottotitolo / descrizione",
      "default": "Libri e stampe dall'universo di Daiana Vaiani."
    },
    {
      "type": "textarea",
      "id": "libri_desc",
      "label": "Descrizione sezione Libri",
      "default": "Storie a fumetti, romanzi visivi e racconti illustrati — ogni volume è un viaggio nei confini della coscienza."
    },
    {
      "type": "textarea",
      "id": "stampe_desc",
      "label": "Descrizione sezione Stampe",
      "default": "Stampe in edizione limitata su carta cotone. Ogni opera è numerata e firmata dall'autrice."
    },
    {
      "type": "text",
      "id": "tab_libri_label",
      "label": "Etichetta Tab Libri/Fumetti",
      "default": "Fumetti"
    },
    {
      "type": "text",
      "id": "tab_stampe_label",
      "label": "Etichetta Tab Stampe",
      "default": "Stampe Artistiche"
    }
  ]
}
{% endschema %}
