<div class="container mt-12 mb-16">
  <div class="section-header reveal-3d">
    <h2>{{ collection.title }}</h2>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mt-12">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p style="grid-column: 1 / -1; text-align: center; color: var(--color-text-secondary); padding: 4rem 0;">
        Nessun prodotto disponibile in questa collezione al momento.
      </p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collezione Principale",
  "settings": []
}
{% endschema %}
