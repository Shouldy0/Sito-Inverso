{% comment %}
  ================================================================
  PAGINA COLLEZIONE — INverso
  Layout: sidebar filtri (tecnica + soggetto) + griglia 3col
  
  Filtri client-side via data-attribute su ogni card.
  Tags Shopify attesi per i filtri:
    Tecnica:  tecnica-pastello | tecnica-grafite | tecnica-carboncino
    Soggetto: soggetto-creature | soggetto-ritratti | soggetto-natura
  
  Il filtro funziona pure senza metafields —
  basta taggare correttamente i prodotti in Shopify Admin.
  ================================================================
{% endcomment %}

{%- assign all_products = collection.products -%}
{%- assign total_count  = all_products.size -%}

<div
  class="col-page"
  data-section-id="{{ section.id }}"
  data-section-type="col-page"
>

  <!-- ── HERO COLLEZIONE ──────────────────────────────────── -->
  <header class="col-hero">
    {%- if section.settings.hero_bg_image != blank -%}
      <div class="col-hero__bg">
        <img
          src="{{ section.settings.hero_bg_image | image_url: width: 1800 }}"
          alt=""
          loading="eager"
          aria-hidden="true"
          width="1800"
        >
        <div class="col-hero__bg-overlay"></div>
      </div>
    {%- endif -%}

    <div class="container col-hero__content">
      <p class="col-hero__label">{{ section.settings.hero_label | default: 'Collezione' }}</p>
      <h1 class="col-hero__title">{{ collection.title | default: section.settings.title | default: 'Fantasy Originali' }}</h1>
      {%- if collection.description != blank -%}
        <p class="col-hero__desc">{{ collection.description | strip_html }}</p>
      {%- elsif section.settings.hero_desc != blank -%}
        <p class="col-hero__desc">{{ section.settings.hero_desc }}</p>
      {%- endif -%}

      <div class="col-hero__meta">
        <span class="col-hero__count">{{ total_count }} {% if total_count == 1 %}opera{% else %}opere{% endif %}</span>
        <span class="col-hero__sep" aria-hidden="true">·</span>
        <span class="col-hero__unique">Tutte le opere sono pezzi unici originali</span>
      </div>
    </div>
  </header>

  <!-- ── LAYOUT: Sidebar + Griglia ────────────────────────── -->
  <div class="col-layout container">

    <!-- ── SIDEBAR FILTRI ────────────────────────────────── -->
    <aside class="col-sidebar" aria-label="Filtri collezione" id="col-filters">

      <!-- Toggle mobile -->
      <button
        class="col-sidebar__toggle"
        id="col-filter-toggle"
        aria-expanded="false"
        aria-controls="col-filter-panel"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
        <span>Filtra</span>
        <span class="col-filter-badge" id="col-filter-count" aria-live="polite" hidden>0</span>
      </button>

      <div class="col-filter-panel" id="col-filter-panel">

        <!-- Filtro TECNICA -->
        <div class="col-filter-group" id="filter-tecnica">
          <button
            class="col-filter-group__header"
            aria-expanded="true"
            aria-controls="filter-tecnica-body"
            type="button"
          >
            <span>Tecnica</span>
            <svg class="col-filter-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="col-filter-group__body" id="filter-tecnica-body">
            {%- assign tecnica_filters = 'Pastello|tecnica-pastello,Grafite|tecnica-grafite,Carboncino|tecnica-carboncino,China|tecnica-china,Matita|tecnica-matita' | split: ',' -%}
            {%- for f in tecnica_filters -%}
              {%- assign parts = f | split: '|' -%}
              <label class="col-filter-option" id="filter-{{ parts[1] }}">
                <input
                  type="checkbox"
                  class="col-filter-checkbox"
                  data-filter-group="tecnica"
                  data-filter-value="{{ parts[1] }}"
                  aria-label="Filtra per tecnica: {{ parts[0] }}"
                >
                <span class="col-filter-check-ui" aria-hidden="true"></span>
                <span class="col-filter-label">{{ parts[0] }}</span>
                <span class="col-filter-count-badge" data-count-for="{{ parts[1] }}">0</span>
              </label>
            {%- endfor -%}
          </div>
        </div>

        <!-- Divisore -->
        <div class="col-filter-divider" role="separator" aria-hidden="true"></div>

        <!-- Filtro SOGGETTO -->
        <div class="col-filter-group" id="filter-soggetto">
          <button
            class="col-filter-group__header"
            aria-expanded="true"
            aria-controls="filter-soggetto-body"
            type="button"
          >
            <span>Soggetto</span>
            <svg class="col-filter-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="col-filter-group__body" id="filter-soggetto-body">
            {%- assign soggetto_filters = 'Creature|soggetto-creature,Ritratti|soggetto-ritratti,Natura|soggetto-natura,Guerrieri|soggetto-guerrieri,Demoni|soggetto-demoni' | split: ',' -%}
            {%- for f in soggetto_filters -%}
              {%- assign parts = f | split: '|' -%}
              <label class="col-filter-option" id="filter-{{ parts[1] }}">
                <input
                  type="checkbox"
                  class="col-filter-checkbox"
                  data-filter-group="soggetto"
                  data-filter-value="{{ parts[1] }}"
                  aria-label="Filtra per soggetto: {{ parts[0] }}"
                >
                <span class="col-filter-check-ui" aria-hidden="true"></span>
                <span class="col-filter-label">{{ parts[0] }}</span>
                <span class="col-filter-count-badge" data-count-for="{{ parts[1] }}">0</span>
              </label>
            {%- endfor -%}
          </div>
        </div>

        <!-- Filtro DISPONIBILITÀ -->
        <div class="col-filter-divider" role="separator" aria-hidden="true"></div>

        <div class="col-filter-group">
          <button
            class="col-filter-group__header"
            aria-expanded="true"
            aria-controls="filter-disp-body"
            type="button"
          >
            <span>Disponibilità</span>
            <svg class="col-filter-chevron" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="col-filter-group__body" id="filter-disp-body">
            <label class="col-filter-option">
              <input type="checkbox" class="col-filter-checkbox" data-filter-group="disponibilita" data-filter-value="disponibile" aria-label="Mostra solo opere disponibili">
              <span class="col-filter-check-ui" aria-hidden="true"></span>
              <span class="col-filter-label">Solo disponibili</span>
            </label>
          </div>
        </div>

        <!-- Reset -->
        <button class="col-filter-reset" id="col-filter-reset" type="button" aria-label="Rimuovi tutti i filtri" hidden>
          Rimuovi filtri
        </button>

      </div>
    </aside>

    <!-- ── GRIGLIA OPERE ──────────────────────────────────── -->
    <div class="col-main">

      <!-- Barra risultati + filtri attivi -->
      <div class="col-results-bar" id="col-results-bar">
        <p class="col-results-count" id="col-results-count" aria-live="polite">
          <span id="col-visible-count">{{ total_count }}</span> opere
        </p>

        <!-- Pillole filtri attivi -->
        <div class="col-active-filters" id="col-active-filters" aria-label="Filtri attivi" aria-live="polite"></div>
      </div>

      <!-- Empty state (nascosta di default) -->
      <div class="col-empty" id="col-empty" hidden aria-live="polite">
        <p class="col-empty__icon">✦</p>
        <p class="col-empty__title">Nessuna opera corrisponde ai filtri selezionati</p>
        <p class="col-empty__sub">Prova a rimuovere uno o più filtri.</p>
        <button class="col-empty__reset" type="button" id="col-empty-reset">Rimuovi tutti i filtri</button>
      </div>

      <!-- Griglia prodotti -->
      {%- if total_count > 0 -%}
        <div class="col-grid" id="col-grid" role="list" aria-label="Opere della collezione">
          {%- for product in all_products -%}

            {%- comment -%} Raccolta tag per filtri {%- endcomment -%}
            {%- assign p_tags_str = product.tags | join: ' ' | downcase -%}

            {%- assign p_tecnica = '' -%}
            {%- if p_tags_str contains 'tecnica-pastello' -%}{%- assign p_tecnica = 'tecnica-pastello' -%}
            {%- elsif p_tags_str contains 'tecnica-grafite' -%}{%- assign p_tecnica = 'tecnica-grafite' -%}
            {%- elsif p_tags_str contains 'tecnica-carboncino' -%}{%- assign p_tecnica = 'tecnica-carboncino' -%}
            {%- elsif p_tags_str contains 'tecnica-china' -%}{%- assign p_tecnica = 'tecnica-china' -%}
            {%- elsif p_tags_str contains 'tecnica-matita' -%}{%- assign p_tecnica = 'tecnica-matita' -%}
            {%- endif -%}

            {%- assign p_soggetto = '' -%}
            {%- if p_tags_str contains 'soggetto-creature' -%}{%- assign p_soggetto = 'soggetto-creature' -%}
            {%- elsif p_tags_str contains 'soggetto-ritratti' -%}{%- assign p_soggetto = 'soggetto-ritratti' -%}
            {%- elsif p_tags_str contains 'soggetto-natura' -%}{%- assign p_soggetto = 'soggetto-natura' -%}
            {%- elsif p_tags_str contains 'soggetto-guerrieri' -%}{%- assign p_soggetto = 'soggetto-guerrieri' -%}
            {%- elsif p_tags_str contains 'soggetto-demoni' -%}{%- assign p_soggetto = 'soggetto-demoni' -%}
            {%- endif -%}

            {%- assign p_avail = 'disponibile' -%}
            {%- unless product.available -%}{%- assign p_avail = 'venduto' -%}{%- endunless -%}

            {%- comment -%} Metafields {%- endcomment -%}
            {%- assign mf_tecnica    = product.metafields.custom.tecnica -%}
            {%- assign mf_dimensioni = product.metafields.custom.dimensioni -%}
            {%- assign mf_anno       = product.metafields.custom.anno -%}

            <article
              class="col-card"
              role="listitem"
              data-tecnica="{{ p_tecnica }}"
              data-soggetto="{{ p_soggetto }}"
              data-disponibilita="{{ p_avail }}"
              data-product-id="{{ product.id }}"
            >
              <a href="{{ product.url }}" class="col-card__link" aria-label="{{ product.title }}">

                <!-- Immagine -->
                <div class="col-card__media">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 750 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      class="col-card__img"
                      loading="lazy"
                      width="750"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'col-card__placeholder' }}
                  {%- endif -%}

                  <!-- Badge Pezzo Unico / Fan Art -->
                  {%- assign p_is_fanart = false -%}
                  {%- if product.metafields.custom.tipo == 'Fan Art' or product.metafields.custom.tipo == 'fan-art' or product.tags contains 'fan-art' or product.tags contains 'anime' or product.tags contains 'manga' -%}
                    {%- assign p_is_fanart = true -%}
                  {%- endif -%}

                  {%- if p_is_fanart -%}
                    <span class="col-card__badge col-card__badge--fanart">
                      Fan Art
                    </span>
                  {%- else -%}
                    <span class="col-card__badge col-card__badge--unique">
                      <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      Pezzo Unico
                    </span>
                  {%- endif -%}

                  {%- unless product.available -%}
                    <span class="col-card__sold-overlay" aria-label="Opera venduta">Venduto</span>
                  {%- endunless -%}

                  <!-- Hover overlay con info rapide -->
                  <div class="col-card__hover" aria-hidden="true">
                    <div class="col-card__hover-inner">
                      {%- if mf_tecnica != blank -%}
                        <p class="col-card__hover-tech">{{ mf_tecnica }}</p>
                      {%- endif -%}
                      <p class="col-card__hover-cta">Vedi l'opera →</p>
                    </div>
                  </div>
                </div>

                <!-- Info sotto l'immagine -->
                <div class="col-card__info">
                  {%- if mf_tecnica != blank -%}
                    <p class="col-card__tech">{{ mf_tecnica }}</p>
                  {%- elsif p_tecnica != blank -%}
                    <p class="col-card__tech">{{ p_tecnica | replace: 'tecnica-', '' | capitalize }}</p>
                  {%- elsif product.type != blank -%}
                    <p class="col-card__tech">{{ product.type }}</p>
                  {%- endif -%}

                  <h2 class="col-card__title">{{ product.title }}</h2>

                  {%- if mf_dimensioni != blank -%}
                    <p class="col-card__dims">{{ mf_dimensioni }}</p>
                  {%- endif -%}

                  <div class="col-card__footer">
                    <span class="col-card__price">
                      {%- if product.available -%}
                        {{ product.price | money }}
                      {%- else -%}
                        <span class="col-card__sold-text">Venduto</span>
                      {%- endif -%}
                    </span>
                    {%- if product.available -%}
                      <span class="col-card__avail">
                        <span class="col-card__avail-dot"></span>
                        Disponibile
                      </span>
                    {%- endif -%}
                  </div>
                </div>

              </a>
            </article>

          {%- endfor -%}
        </div>

      {%- else -%}
        <div class="col-empty" aria-live="polite">
          <p class="col-empty__icon">✦</p>
          <p class="col-empty__title">Nessuna opera in questa collezione</p>
          <p class="col-empty__sub">Torna presto — nuove creazioni in arrivo.</p>
        </div>
      {%- endif -%}

    </div>
    <!-- /col-main -->

  </div>
  <!-- /col-layout -->

</div>

<!-- ── JAVASCRIPT FILTRI ─────────────────────────────────── -->
<script>
(function () {
  'use strict';

  // ── Stato filtri ────────────────────────────────────────
  var activeFilters = { tecnica: [], soggetto: [], disponibilita: [] };

  var grid       = document.getElementById('col-grid');
  var emptyState = document.getElementById('col-empty');
  var countEl    = document.getElementById('col-visible-count');
  var resetBtn   = document.getElementById('col-filter-reset');
  var emptyReset = document.getElementById('col-empty-reset');
  var activePill = document.getElementById('col-active-filters');
  var filterBadge= document.getElementById('col-filter-count');
  var allCards   = grid ? Array.from(grid.querySelectorAll('.col-card')) : [];

  // Conta per ogni valore di filtro
  function updateCountBadges() {
    var counts = {};
    allCards.forEach(function (card) {
      ['tecnica', 'soggetto', 'disponibilita'].forEach(function (group) {
        var val = card.getAttribute('data-' + group);
        if (val) {
          counts[val] = (counts[val] || 0) + 1;
        }
      });
    });
    document.querySelectorAll('[data-count-for]').forEach(function (el) {
      var key = el.getAttribute('data-count-for');
      el.textContent = counts[key] || 0;
      el.hidden = !counts[key];
    });
  }

  // ── Applica filtri ──────────────────────────────────────
  function applyFilters() {
    var hasAny = false;
    Object.keys(activeFilters).forEach(function (g) {
      if (activeFilters[g].length > 0) hasAny = true;
    });

    var visible = 0;

    allCards.forEach(function (card) {
      var show = true;

      Object.keys(activeFilters).forEach(function (group) {
        if (activeFilters[group].length === 0) return;
        var cardVal = card.getAttribute('data-' + group) || '';
        var match = activeFilters[group].some(function (f) {
          return cardVal === f;
        });
        if (!match) show = false;
      });

      card.hidden = !show;
      if (show) visible++;
    });

    // Count
    if (countEl) countEl.textContent = visible;

    // Empty state
    if (emptyState) {
      emptyState.hidden = (visible > 0);
    }

    // Reset btn
    var totalActive = Object.values(activeFilters).reduce(function(a,b){return a+b.length;}, 0);
    if (resetBtn) resetBtn.hidden = !hasAny;
    if (filterBadge) {
      filterBadge.textContent = totalActive;
      filterBadge.hidden = totalActive === 0;
    }

    // Pills filtri attivi
    renderActivePills();
  }

  // ── Pillole filtri attivi ────────────────────────────────
  var filterLabels = {
    'tecnica-pastello':    'Pastello',
    'tecnica-grafite':     'Grafite',
    'tecnica-carboncino':  'Carboncino',
    'tecnica-china':       'China',
    'tecnica-matita':      'Matita',
    'soggetto-creature':   'Creature',
    'soggetto-ritratti':   'Ritratti',
    'soggetto-natura':     'Natura',
    'soggetto-guerrieri':  'Guerrieri',
    'soggetto-demoni':     'Demoni',
    'disponibile':         'Solo disponibili'
  };

  function renderActivePills() {
    if (!activePill) return;
    activePill.innerHTML = '';

    Object.keys(activeFilters).forEach(function (group) {
      activeFilters[group].forEach(function (val) {
        var pill = document.createElement('button');
        pill.className = 'col-active-pill';
        pill.type = 'button';
        pill.setAttribute('aria-label', 'Rimuovi filtro: ' + (filterLabels[val] || val));
        pill.innerHTML =
          '<span>' + (filterLabels[val] || val) + '</span>' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

        pill.addEventListener('click', function () {
          var idx = activeFilters[group].indexOf(val);
          if (idx > -1) activeFilters[group].splice(idx, 1);
          var cb = document.querySelector(
            '.col-filter-checkbox[data-filter-group="' + group + '"][data-filter-value="' + val + '"]'
          );
          if (cb) cb.checked = false;
          applyFilters();
        });

        activePill.appendChild(pill);
      });
    });
  }

  // ── Event listeners checkbox ─────────────────────────────
  document.querySelectorAll('.col-filter-checkbox').forEach(function (cb) {
    cb.addEventListener('change', function () {
      var group = cb.getAttribute('data-filter-group');
      var val   = cb.getAttribute('data-filter-value');

      if (cb.checked) {
        if (!activeFilters[group].includes(val)) activeFilters[group].push(val);
      } else {
        activeFilters[group] = activeFilters[group].filter(function (v) { return v !== val; });
      }
      applyFilters();
    });
  });

  // ── Reset ────────────────────────────────────────────────
  function resetAll() {
    Object.keys(activeFilters).forEach(function (g) { activeFilters[g] = []; });
    document.querySelectorAll('.col-filter-checkbox').forEach(function (cb) { cb.checked = false; });
    applyFilters();
  }

  if (resetBtn)   resetBtn.addEventListener('click', resetAll);
  if (emptyReset) emptyReset.addEventListener('click', resetAll);

  // ── Accordion gruppi filtri ──────────────────────────────
  document.querySelectorAll('.col-filter-group__header').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!expanded).toString());
      var bodyId = btn.getAttribute('aria-controls');
      var body   = document.getElementById(bodyId);
      if (body) body.hidden = expanded;
    });
  });

  // ── Mobile sidebar toggle ────────────────────────────────
  var toggleBtn  = document.getElementById('col-filter-toggle');
  var filterPanel = document.getElementById('col-filter-panel');

  if (toggleBtn && filterPanel) {
    toggleBtn.addEventListener('click', function () {
      var open = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!open).toString());
      filterPanel.hidden = open;
    });

    // Inizializza mobile
    if (window.innerWidth < 900) {
      filterPanel.hidden = true;
    }
  }

  // ── Init ─────────────────────────────────────────────────
  updateCountBadges();
  applyFilters();

})();
</script>

{% schema %}
{
  "name": "Collezione con Filtri",
  "settings": [
    {
      "type": "text",
      "id": "hero_label",
      "label": "Etichetta hero",
      "default": "Collezione"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo (fallback se non c'è collezione)",
      "default": "Fantasy Originali"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Descrizione collezione (fallback)",
      "default": "Creature, guerrieri e volti nati dall'immaginazione. Ogni opera è un personaggio originale di Daiana Vaiani."
    },
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Immagine di sfondo hero (opzionale)"
    }
  ]
}
{% endschema %}
