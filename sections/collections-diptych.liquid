{% comment %}
  SEZIONE "LE DUE ANIME" — INverso Homepage
  Due box affiancati: Originali (Inchiostro) / Universo (Stampe & Fan Art)
{% endcomment %}

<section class="hp-diptych" data-section-id="{{ section.id }}">

  {%- if section.settings.section_label != blank -%}
    <div class="hp-diptych__header container">
      <p class="hp-diptych__label">{{ section.settings.section_label | default: 'La Filosofia di INverso' }}</p>
    </div>
  {%- endif -%}

  <div class="hp-diptych__grid">

    <!-- Box sinistro: Originali -->
    <a
      href="{{ section.settings.left_url | default: '/collections/originali' }}"
      class="hp-diptych__box hp-diptych__box--left"
      id="diptych-originali"
      aria-label="{{ section.settings.left_title | default: 'Originali' }}"
    >
      <div class="hp-diptych__media">
        {%- if section.settings.left_image != blank -%}
          <img
            src="{{ section.settings.left_image | image_url: width: 1200 }}"
            alt="{{ section.settings.left_image_alt | default: 'Originali — Daiana Vaiani' }}"
            class="hp-diptych__img"
            loading="lazy"
            width="1200"
          >
        {%- else -%}
          <img
            src="{{ 'close-up-china.png' | asset_url }}"
            alt="Originali — China, Matita, Carboncino"
            class="hp-diptych__img"
            loading="lazy"
          >
        {%- endif -%}
        <div class="hp-diptych__overlay hp-diptych__overlay--left"></div>
      </div>

      <div class="hp-diptych__content">
        <p class="hp-diptych__eyebrow">{{ section.settings.left_eyebrow | default: 'China • Matita • Carboncino' }}</p>
        <h2 class="hp-diptych__title">{{ section.settings.left_title | default: 'Originali' }}</h2>
        <p class="hp-diptych__desc">{{ section.settings.left_desc | default: 'Simbolico, introspettivo, psicologico. Pezzi unici irripetibili e bozzetti di studio dove l\'inchiostro dà corpo all\'inconscio.' }}</p>
        <span class="hp-diptych__cta">
          {{ section.settings.left_cta | default: 'Scopri gli Originali' }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </span>
      </div>
    </a>

    <!-- Box destro: Universo -->
    <a
      href="{{ section.settings.right_url | default: '/collections/universo' }}"
      class="hp-diptych__box hp-diptych__box--right"
      id="diptych-universo"
      aria-label="{{ section.settings.right_title | default: 'Universo' }}"
    >
      <div class="hp-diptych__media">
        {%- if section.settings.right_image != blank -%}
          <img
            src="{{ section.settings.right_image | image_url: width: 1200 }}"
            alt="{{ section.settings.right_image_alt | default: 'Universo — Pastelli e Fan Art' }}"
            class="hp-diptych__img"
            loading="lazy"
            width="1200"
          >
        {%- else -%}
          <img
            src="{{ 'close-up-pastelli.png' | asset_url }}"
            alt="Universo — Pastelli, Colore, Fandom"
            class="hp-diptych__img"
            loading="lazy"
          >
        {%- endif -%}
        <div class="hp-diptych__overlay hp-diptych__overlay--right"></div>
      </div>

      <div class="hp-diptych__content">
        <p class="hp-diptych__eyebrow">{{ section.settings.right_eyebrow | default: 'Pastelli • Colore • Fandom' }}</p>
        <h2 class="hp-diptych__title">{{ section.settings.right_title | default: 'Universo' }}</h2>
        <p class="hp-diptych__desc">{{ section.settings.right_desc | default: 'Pop, luminoso e accessibile. Stampe Fine Art d\'autore (Jujutsu Kaisen, Naruto, Dragon Ball) e tirature su carte di pregio.' }}</p>
        <span class="hp-diptych__cta">
          {{ section.settings.right_cta | default: 'Esplora l\'Universo' }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </span>
      </div>
    </a>

  </div>
</section>

{% schema %}
{
  "name": "Le Due Anime — INverso",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Etichetta sezione",
      "default": "La Filosofia di INverso"
    },
    {
      "type": "header",
      "content": "Box Sinistro — Originali"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Immagine Originali"
    },
    {
      "type": "text",
      "id": "left_eyebrow",
      "label": "Etichetta piccola",
      "default": "China • Matita • Carboncino"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Titolo",
      "default": "Originali"
    },
    {
      "type": "textarea",
      "id": "left_desc",
      "label": "Descrizione",
      "default": "Simbolico, introspettivo, psicologico. Pezzi unici irripetibili dove l'inchiostro dà corpo all'inconscio."
    },
    {
      "type": "url",
      "id": "left_url",
      "label": "Link collezione"
    },
    {
      "type": "header",
      "content": "Box Destro — Universo"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Immagine Universo"
    },
    {
      "type": "text",
      "id": "right_eyebrow",
      "label": "Etichetta piccola",
      "default": "Pastelli • Colore • Fandom"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Titolo",
      "default": "Universo"
    },
    {
      "type": "textarea",
      "id": "right_desc",
      "label": "Descrizione",
      "default": "Pop, luminoso e accessibile. Stampe Fine Art d'autore (Jujutsu Kaisen, Naruto, Dragon Ball) e tirature d'autore."
    },
    {
      "type": "url",
      "id": "right_url",
      "label": "Link collezione"
    }
  ],
  "presets": [
    {
      "name": "Le Due Anime — INverso"
    }
  ]
}
{% endschema %}
