    },
    {
      "type": "text",
      "id": "right_eyebrow",
      "label": "Etichetta piccola",
      "default": "Fan Art dichiarata"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Titolo",
      "default": "Anime & Manga Art"
    },
    {
      "type": "textarea",
      "id": "right_desc",
      "label": "Descrizione breve",
      "default": "Naruto, Dragon Ball, Jujutsu Kaisen — disegnati a mano, non stampati."
    },
    {
      "type": "url",
      "id": "right_url",
      "label": "Link collezione"
    },
    {
      "type": "text",
      "id": "right_cta",
      "label": "Testo CTA",
      "default": "Esplora la collezione"
    }
  ],
  "presets": [
    {
      "name": "Due Mondi — Collezioni"
    }
  ]
}
{% endschema %}
