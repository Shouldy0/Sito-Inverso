<footer class="footer">
  <div class="container footer-content">

    <!-- Brand -->
    <div class="footer-brand">
      <h3>{{ section.settings.brand_name | default: 'INverso' }}</h3>
      <p>{{ section.settings.brand_slogan | default: 'Opere originali di Daiana Vaiani.' }}</p>

      <!-- Social links -->
      <div class="footer-social">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Instagram di Daiana Vaiani" id="footer-instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="TikTok di Daiana Vaiani" id="footer-tiktok">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_pinterest != blank -%}
          <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Pinterest di Daiana Vaiani" id="footer-pinterest">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 0 0-3.5 19.3c0-.8.1-2 .3-2.9l1.9-8.2s-.5-.9-.5-2.3c0-2.2 1.3-3.8 2.9-3.8 1.4 0 2 1 2 2.3 0 1.4-.9 3.5-1.4 5.4-.4 1.6.8 2.9 2.4 2.9 2.9 0 4.8-3.7 4.8-8.1 0-3.3-2.2-5.8-6.2-5.8A6.9 6.9 0 0 0 8 9.6c0 1.3.4 2.2.9 2.8a.4.4 0 0 1 .1.3c-.1.4-.3 1.2-.3 1.4 0 .2-.2.3-.4.2C6.4 13.4 5 11.5 5 9c0-4 3.4-8.8 10.1-8.8C20.4.2 24 3.9 24 8.8c0 6.3-3.5 11-8.6 11-1.7 0-3.3-.9-3.9-2l-1.1 4.3c-.4 1.4-1.2 2.8-2 3.8A10 10 0 0 0 12 22z"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.contact_email != blank -%}
        <p style="margin-top: 1.2rem; font-size: 0.82rem;">
          <a href="mailto:{{ section.settings.contact_email }}" style="color: var(--color-text-secondary);">
            {{ section.settings.contact_email }}
          </a>
        </p>
      {%- endif -%}
    </div>

    <!-- Link Esplora -->
    <div class="footer-links">
      <h4>{{ section.settings.menu_1_title | default: 'Opere' }}</h4>
      {%- for link in linklists[section.settings.menu_1].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- if linklists[section.settings.menu_1].links.size == 0 -%}
        <a href="/collections/fantasy-originali">Fantasy Originali</a>
        <a href="/collections/anime-manga-art">Anime & Manga Art</a>
        <a href="/collections/all">Tutte le Opere</a>
      {%- endif -%}
    </div>

    <!-- Link Informazioni -->
    <div class="footer-links">
      <h4>{{ section.settings.menu_2_title | default: 'Informazioni' }}</h4>
      {%- for link in linklists[section.settings.menu_2].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- if linklists[section.settings.menu_2].links.size == 0 -%}
        <a href="/pages/artista">L'Artista</a>
        <a href="/pages/spedizioni">Spedizioni</a>
        <a href="/pages/termini">Termini & Policy</a>
        <a href="/pages/contatti">Contatti</a>
      {%- endif -%}
    </div>

    <!-- Newsletter -->
    <div class="footer-newsletter">
      <h4>{{ section.settings.newsletter_title | default: 'Studio Aperto' }}</h4>
      <p class="newsletter-desc">
        {{ section.settings.newsletter_text | default: 'Anteprime delle nuove opere, dietro le quinte dello studio e accesso prioritario alle creazioni di Daiana Vaiani.' }}
      </p>
      
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="input-group">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="La tua email..." 
            class="newsletter-input" 
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-label="Iscriviti alla newsletter di INverso"
            required
          >
          <button type="submit" class="newsletter-submit-btn" name="commit" aria-label="Iscriviti">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <div class="newsletter-success">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Benvenuto nell'INverso! A presto.</span>
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="newsletter-error">Email non valida o già registrata.</p>
        {%- endif -%}
      {% endform %}
    </div>

  </div>

  <!-- Trust Badges -->
  <div class="footer-trust">
    <div class="container">
      <div class="trust-badges">
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Imballaggio protettivo per opere d'arte
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Pagamento Sicuro
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
          Ogni opera firmata dall'artista
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Pezzi Unici Certificati
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} INverso — Daiana Vaiani. Tutti i diritti riservati.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer INverso",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nome Brand",
      "default": "INverso"
    },
    {
      "type": "text",
      "id": "brand_slogan",
      "label": "Slogan Brand",
      "default": "Opere originali di Daiana Vaiani."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Link Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "Link TikTok (opzionale)"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Link Pinterest (opzionale)"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email di contatto",
      "default": "info@inverso.art"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Titolo Primo Menu",
      "default": "Opere"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Primo Menu Link",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Titolo Secondo Menu",
      "default": "Informazioni"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Secondo Menu Link"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Titolo Newsletter",
      "default": "Studio Aperto"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Descrizione Newsletter",
      "default": "Anteprime delle nuove opere, dietro le quinte dello studio e accesso prioritario alle creazioni di Daiana Vaiani."
    }
  ]
}
{% endschema %}
