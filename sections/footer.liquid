<footer class="footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <h3>{{ section.settings.brand_name | default: shop.name }}</h3>
      <p>{{ section.settings.brand_slogan }}</p>
    </div>
    
    <div class="footer-links">
      <h4>{{ section.settings.menu_1_title }}</h4>
      {%- for link in linklists[section.settings.menu_1].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>

    <div class="footer-links">
      <h4>{{ section.settings.menu_2_title }}</h4>
      {%- for link in linklists[section.settings.menu_2].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>

    <div class="footer-newsletter">
      <h4>{{ section.settings.newsletter_title }}</h4>
      <p class="newsletter-desc">
        {{ section.settings.newsletter_text }}
      </p>
      
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="input-group">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="La tua email..." 
            class="newsletter-input" 
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >
          <button type="submit" class="newsletter-submit-btn" name="commit" aria-label="Iscriviti">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <div class="newsletter-success animate-fade-in" style="margin-top: 1rem;">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon-success"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Iscrizione completata con successo! A presto.</span>
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="newsletter-error" style="margin-top: 0.5rem; color: #ef4444; font-size: 0.8rem;">
            <span>E-mail non valida o già registrata.</span>
          </div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
  
  <!-- Trust Badges -->
  <div class="footer-trust">
    <div class="container">
      <div class="trust-badges">
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          Spedizione con tracciamento
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Pagamento 100% Sicuro
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          Reso entro 14 giorni
        </div>
        <div class="trust-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          Visa · Mastercard · PayPal
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tutti i diritti riservati.</p>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nome Brand",
      "default": "DAIANA"
    },
    {
      "type": "text",
      "id": "brand_slogan",
      "label": "Slogan Brand",
      "default": "Ogni storia è una soglia."
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Titolo Primo Menu",
      "default": "Esplora"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Primo Menu Link",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Titolo Secondo Menu",
      "default": "Informazioni"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Secondo Menu Link"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Titolo Newsletter",
      "default": "Lettere dall'Ombra"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Descrizione Newsletter",
      "default": "Ricevi in anteprima estratti dei nuovi fumetti, aggiornamenti sui dietro le quinte e l'accesso prioritario alle opere originali."
    }
  ]
}
{% endschema %}
