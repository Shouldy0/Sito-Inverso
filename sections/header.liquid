<nav class="navbar" data-section-id="{{ section.id }}" data-section-type="header">
  <div class="navbar-container">
    <div class="navbar-logo">
      <a href="{{ routes.root_url }}">{{ shop.name }}</a>
    </div>

    <!-- Desktop Menu -->
    <div class="navbar-links">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="{% if link.active %}active{% endif %}">{{ link.title }}</a>
        {%- unless forloop.last -%}
          {%- if section.settings.show_divider -%}
            <span class="navbar-divider">|</span>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>

    <div class="navbar-actions">
      <a href="{{ routes.cart_url }}" class="cart-button" aria-label="Carrello">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count {% if cart.item_count == 0 %}visually-hidden{% endif %}">{{ cart.item_count }}</span>
      </a>
      
      <button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu principale"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Mostra separatore tra link"
    }
  ]
}
{% endschema %}
