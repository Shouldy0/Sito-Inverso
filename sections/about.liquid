<div class="about-section" data-section-id="{{ section.id }}" data-section-type="about">
  <div class="container">
    <div class="about-inner">

      <!-- Immagine / Foto artista -->
      <div class="about-image-col">
        <div class="about-image-frame">
          {%- if section.settings.author_image != blank -%}
            <img
              src="{{ section.settings.author_image | image_url: width: 760 }}"
              alt="{{ section.settings.author_name | default: 'Daiana Vaiani' }}"
              width="760"
              loading="lazy"
            >
          {%- else -%}
            <div class="about-image-placeholder">
              <span class="placeholder-icon">✦</span>
              <span style="font-size:0.82rem; opacity:0.4;">Aggiungi foto artista nell'Admin</span>
            </div>
          {%- endif -%}
        </div>
        <div class="about-accent-line"></div>
      </div>

      <!-- Testo bio -->
      <div class="about-text-col">
        <span class="about-label">{{ section.settings.label | default: "L'Artista" }}</span>

        <h2 class="about-title">
          {{ section.settings.title | default: 'Daiana Vaiani' }}
        </h2>

        {%- if section.settings.bio != blank -%}
          <p class="about-bio">{{ section.settings.bio }}</p>
        {%- else -%}
          <p class="about-bio">Artista e illustratrice, Daiana Vaiani crea opere originali a pastello, carboncino, matita e china. Ogni disegno nasce da un'esigenza di dare forma visibile a ciò che non si può dire a parole — emozioni, mondi immaginari, frammenti di un universo tutto suo.</p>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="about-quote">
            {{ section.settings.quote }}
          </blockquote>
        {%- endif -%}

        <div class="about-actions">
          {%- if section.settings.cta_url != blank -%}
            <a href="{{ section.settings.cta_url }}" class="btn btn-primary" id="about-cta-artista">
              <span class="btn-content">{{ section.settings.cta_label | default: "Scopri l'Artista" }}</span>
            </a>
          {%- else -%}
            <a href="/pages/artista" class="btn btn-primary" id="about-cta-artista">
              <span class="btn-content">Scopri l'Artista</span>
            </a>
          {%- endif -%}

          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost" id="about-instagram-link" style="gap:0.5rem; display:inline-flex; align-items:center;">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <span class="btn-content">Instagram</span>
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "L'Artista — Mini Bio",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etichetta sopra titolo",
      "default": "L'Artista"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Nome / Titolo",
      "default": "Daiana Vaiani"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Biografia breve",
      "default": "Artista e illustratrice, Daiana Vaiani crea opere originali a pastello, carboncino, matita e china. Ogni disegno nasce da un'esigenza di dare forma visibile a ciò che non si può dire a parole — emozioni, mondi immaginari, frammenti di un universo tutto suo."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Citazione (opzionale)",
      "default": "\"Disegnare è strappare un pezzo di coscienza all'ombra e fissarlo sulla carta.\"\n— Daiana Vaiani"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Foto artista"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Alt text immagine",
      "default": "Daiana Vaiani — Artista"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link pulsante principale"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Testo pulsante",
      "default": "Scopri l'Artista"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Link Instagram"
    }
  ],
  "presets": [
    {
      "name": "L'Artista — Mini Bio"
    }
  ]
}
{% endschema %}
