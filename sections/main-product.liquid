{% comment %}
  ================================================================
  PAGINA PRODOTTO — INverso
  Opere d'arte originali di Daiana Vaiani
  
  Struttura:
  - Galleria immagini sinistra (zoom hover + thumbnail strip)
  - Scheda tecnica + acquisto destra
  - Descrizione lunga sotto
  - Cross-sell "Altre opere" in fondo
  
  Metafields attesi (namespace: custom):
    tecnica, dimensioni, anno, firmata, incorniciata,
    tipo ("Originale" | "Fan Art"), franchise, spedizione_note
  ================================================================
{% endcomment %}

{%- assign is_original = false -%}
{%- assign is_fanart = false -%}

{%- comment -%} Classificazione via metafield "tipo" o fallback su tag {%- endcomment -%}
{%- if product.metafields.custom.tipo != blank -%}
  {%- if product.metafields.custom.tipo == 'Fan Art' or product.metafields.custom.tipo == 'fan-art' -%}
    {%- assign is_fanart = true -%}
  {%- else -%}
    {%- assign is_original = true -%}
  {%- endif -%}
{%- else -%}
  {%- if product.tags contains 'fan-art' or product.tags contains 'fanart' or product.tags contains 'anime' or product.tags contains 'manga' -%}
    {%- assign is_fanart = true -%}
  {%- else -%}
    {%- assign is_original = true -%}
  {%- endif -%}
{%- endif -%}

{%- assign is_available = product.available -%}

{%- comment -%} Metafields {%- endcomment -%}
{%- assign mf_tecnica      = product.metafields.custom.tecnica -%}
{%- assign mf_dimensioni   = product.metafields.custom.dimensioni -%}
{%- assign mf_anno         = product.metafields.custom.anno -%}
{%- assign mf_firmata      = product.metafields.custom.firmata -%}
{%- assign mf_incorniciata = product.metafields.custom.incorniciata -%}
{%- assign mf_franchise    = product.metafields.custom.franchise -%}
{%- assign mf_spedizione   = product.metafields.custom.spedizione_note -%}
{%- assign mf_supporto     = product.metafields.custom.supporto -%}

<article class="pd-page" data-section-id="{{ section.id }}" itemscope itemtype="https://schema.org/Product">

  <!-- ============================================================
       BLOCCO PRINCIPALE: Galleria + Scheda
       ============================================================ -->
  <div class="pd-main container">

    <!-- ──────────────────────────────────────────────────────────
         COLONNA SINISTRA — Galleria
         ────────────────────────────────────────────────────────── -->
    <div class="pd-gallery" role="region" aria-label="Galleria immagini opera">

      <!-- Immagine principale (zoomabile) -->
      <div
        class="pd-gallery__main-frame"
        id="pd-main-frame"
        aria-label="Clicca o hover per ingrandire"
      >
        <div class="pd-gallery__zoom-lens" id="pd-zoom-lens" aria-hidden="true"></div>

        {%- if product.featured_image != blank -%}
          <img
            id="pd-main-img"
            src="{{ product.featured_image | image_url: width: 1400 }}"
            data-zoom="{{ product.featured_image | image_url: width: 2400 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            class="pd-gallery__main-img"
            width="1400"
            loading="eager"
            fetchpriority="high"
            itemprop="image"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pd-gallery__main-img placeholder-svg' }}
        {%- endif -%}

        <!-- Badge tipo opera (visibile sulla galleria) -->
        {%- if is_original -%}
          <div class="pd-badge-wrapper" aria-label="Tipo opera">
            <span class="pd-badge pd-badge--unique">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              Pezzo Unico
            </span>
          </div>
        {%- elsif is_fanart -%}
          <div class="pd-badge-wrapper" aria-label="Tipo opera">
            <span class="pd-badge pd-badge--fanart">Fan Art</span>
          </div>
        {%- endif -%}

        <!-- Zoom hint -->
        <div class="pd-gallery__zoom-hint" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          Hover per zoom · Click per ingrandire
        </div>
      </div>

      <!-- Striscia thumbnail -->
      {%- if product.images.size > 1 -%}
        <div class="pd-gallery__thumbs" role="list" aria-label="Foto dell'opera">
          {%- for image in product.images -%}
            <button
              class="pd-thumb {% if forloop.first %}pd-thumb--active{% endif %}"
              role="listitem"
              data-full="{{ image | image_url: width: 1400 }}"
              data-zoom="{{ image | image_url: width: 2400 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="Foto {{ forloop.index }}: {{ image.alt | default: product.title }}"
              aria-pressed="{{ forloop.first | json }}"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                loading="lazy"
                width="160"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    <!-- /pd-gallery -->

    <!-- ──────────────────────────────────────────────────────────
         COLONNA DESTRA — Scheda tecnica + acquisto
         ────────────────────────────────────────────────────────── -->
    <div class="pd-info" itemprop="offers" itemscope itemtype="https://schema.org/Offer">

      <!-- Breadcrumb -->
      <nav class="pd-breadcrumb" aria-label="Percorso di navigazione">
        <a href="/" class="pd-breadcrumb__link">INverso</a>
        <span class="pd-breadcrumb__sep" aria-hidden="true">›</span>
        {%- if product.collections.size > 0 -%}
          <a href="{{ product.collections.first.url }}" class="pd-breadcrumb__link">{{ product.collections.first.title }}</a>
          <span class="pd-breadcrumb__sep" aria-hidden="true">›</span>
        {%- endif -%}
        <span class="pd-breadcrumb__current" aria-current="page">{{ product.title }}</span>
      </nav>

      <!-- Tipo opera (etichetta sopra titolo) -->
      <p class="pd-type-label">
        {%- if is_fanart -%}
          Fan Art · {{ mf_tecnica | default: product.type }}
        {%- else -%}
          Opera Originale{%- if mf_tecnica != blank -%} · {{ mf_tecnica }}{%- endif -%}
        {%- endif -%}
      </p>

      <!-- Titolo opera -->
      <h1 class="pd-title" itemprop="name">{{ product.title }}</h1>

      <!-- Badge "Pezzo Unico" inline (grande, testo) -->
      {%- if is_original -%}
        <div class="pd-unique-banner" role="note" aria-label="Opera originale, pezzo unico">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>Pezzo Unico — Opera Originale Firmata da Daiana Vaiani</span>
        </div>
      {%- endif -%}

      <!-- ── PREZZO ── -->
      <div class="pd-price-row">
        <p class="pd-price" itemprop="price" content="{{ product.price | divided_by: 100.0 }}">
          {{ product.price | money }}
        </p>
        <meta itemprop="priceCurrency" content="EUR">
        <meta itemprop="availability" content="{% if is_available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">

        <!-- Disponibilità -->
        {%- if is_available -%}
          <span class="pd-availability pd-availability--available">
            <span class="pd-avail-dot"></span>
            Pezzo unico disponibile
          </span>
        {%- else -%}
          <span class="pd-availability pd-availability--sold">
            <span class="pd-avail-dot"></span>
            Venduto
          </span>
        {%- endif -%}
      </div>

      <!-- ── FAN ART DISCLAIMER ── -->
      {%- if is_fanart -%}
        <div class="pd-fanart-note" role="note">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p>
            Opera ispirata a
            <strong>{{ mf_franchise | default: 'un franchise esistente' }}</strong>,
            creata come fan art non ufficiale da Daiana Vaiani.
            Non affiliata né approvata dal detentore dei diritti originali.
            Venduta come opera artistica originale.
          </p>
        </div>
      {%- endif -%}

      <!-- ── SCHEDA TECNICA ── -->
      {%- assign has_specs = false -%}
      {%- if mf_tecnica != blank or mf_dimensioni != blank or mf_anno != blank or mf_firmata != blank or mf_incorniciata != blank or mf_supporto != blank -%}
        {%- assign has_specs = true -%}
      {%- endif -%}

      {%- if has_specs -%}
        <div class="pd-specs" role="table" aria-label="Specifiche tecniche dell'opera">
          <p class="pd-specs__title">Scheda Tecnica</p>
          <dl class="pd-specs__table">

            {%- if mf_tecnica != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Tecnica</dt>
                <dd class="pd-spec-value" role="cell">{{ mf_tecnica }}</dd>
              </div>
            {%- endif -%}

            {%- if mf_dimensioni != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Dimensioni</dt>
                <dd class="pd-spec-value" role="cell">{{ mf_dimensioni }}</dd>
              </div>
            {%- endif -%}

            {%- if mf_supporto != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Supporto</dt>
                <dd class="pd-spec-value" role="cell">{{ mf_supporto }}</dd>
              </div>
            {%- endif -%}

            {%- if mf_anno != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Anno</dt>
                <dd class="pd-spec-value" role="cell">{{ mf_anno }}</dd>
              </div>
            {%- endif -%}

            {%- if mf_firmata != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Firmata</dt>
                <dd class="pd-spec-value" role="cell">
                  {%- assign firmata_lower = mf_firmata | downcase -%}
                  {%- if firmata_lower == 'si' or firmata_lower == 'sì' or firmata_lower == 'yes' or firmata_lower == 'true' -%}
                    <span class="pd-spec-check">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      Sì, firmata a mano
                    </span>
                  {%- else -%}
                    {{ mf_firmata }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}

            {%- if mf_incorniciata != blank -%}
              <div class="pd-spec-row" role="row">
                <dt class="pd-spec-label" role="rowheader">Incorniciata</dt>
                <dd class="pd-spec-value" role="cell">
                  {%- assign incorniciata_lower = mf_incorniciata | downcase -%}
                  {%- if incorniciata_lower == 'si' or incorniciata_lower == 'sì' or incorniciata_lower == 'yes' or incorniciata_lower == 'true' -%}
                    <span class="pd-spec-check">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      Sì, inclusa cornice
                    </span>
                  {%- elsif incorniciata_lower == 'no' or incorniciata_lower == 'false' -%}
                    Non incorniciata
                  {%- else -%}
                    {{ mf_incorniciata }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}

          </dl>
        </div>
      {%- endif -%}

      <!-- ── FORM ACQUISTO ── -->
      <style>
        @keyframes pulse-dot {
          0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
          70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
          100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
      </style>
      <div id="pd-live-viewers" style="display: none; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--color-text-secondary); background-color: rgba(255, 255, 255, 0.03); padding: 0.6rem 1rem; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.05); margin-bottom: 1.5rem;">
        <span style="width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; display: inline-block; animation: pulse-dot 2s infinite;"></span>
        <span><strong id="pd-live-count" style="color: var(--color-text-primary); font-weight: 600;"></strong> persone stanno guardando quest'opera ora</span>
      </div>
      
      {%- form 'product', product, id: 'pd-add-form', class: 'pd-purchase-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <button
          type="submit"
          class="pd-add-btn {% unless is_available %}pd-add-btn--sold{% endunless %}"
          id="pd-add-to-cart"
          {% unless is_available %}disabled aria-disabled="true"{% endunless %}
        >
          {%- if is_available -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {%- if product.tags contains 'preorder' -%}
              Pre-ordina ora
            {%- else -%}
              Aggiungi al Carrello
            {%- endif -%}
          {%- else -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            Opera non più disponibile
          {%- endif -%}
        </button>
      {%- endform -%}

      <!-- ── NOTE SPEDIZIONE ── -->
      <div class="pd-shipping">
        {%- if mf_spedizione != blank -%}
          <p>{{ mf_spedizione }}</p>
        {%- else -%}
          <p>
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Preparazione in 2–3 giorni lavorativi. Spedizione in busta rigida o tubo protettivo.
          </p>
          {%- if is_original -%}
            <p class="pd-shipping__premium">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Le opere originali vengono spedite con imballaggio protettivo speciale e assicurazione sul valore.
            </p>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- ── GARANZIE / TRUST ── -->
      <div class="pd-trust">
        <div class="pd-trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>Opera autentica, firmata dall'artista</span>
        </div>
        <div class="pd-trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Pagamento sicuro</span>
        </div>
        <div class="pd-trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Spedita dall'Italia</span>
        </div>
      </div>

    </div>
    <!-- /pd-info -->

  </div>
  <!-- /pd-main -->

  <!-- ============================================================
       DESCRIZIONE LUNGA
       ============================================================ -->
  {%- if product.description != blank -%}
    <div class="pd-description container" itemprop="description">
      <div class="pd-description__inner">
        <h2 class="pd-description__title">Sull'Opera</h2>
        <div class="pd-description__body">
          {{ product.description }}
        </div>
      </div>
    </div>
  {%- endif -%}

</article>

<!-- ============================================================
     LIGHTBOX
     ============================================================ -->
<div id="pd-lightbox" class="pd-lightbox" role="dialog" aria-modal="true" aria-label="Visualizzazione ingrandita">
  <button class="pd-lightbox__close" id="pd-lightbox-close" aria-label="Chiudi ingrandimento">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div class="pd-lightbox__overlay" id="pd-lightbox-overlay"></div>
  <div class="pd-lightbox__img-wrap">
    <img id="pd-lightbox-img" src="" alt="">
  </div>
</div>

<script>
(function () {
  'use strict';

  // ── Thumbnail switcher ──────────────────────────────────────
  var mainImg  = document.getElementById('pd-main-img');
  var thumbs   = document.querySelectorAll('.pd-thumb');

  thumbs.forEach(function (thumb) {
    function activate() {
      var full = thumb.getAttribute('data-full');
      var zoom = thumb.getAttribute('data-zoom');
      var alt  = thumb.getAttribute('data-alt');
      if (mainImg && full) {
        mainImg.src = full;
        mainImg.alt = alt || '';
        mainImg.setAttribute('data-zoom', zoom || full);
      }
      thumbs.forEach(function (t) {
        t.classList.remove('pd-thumb--active');
        t.setAttribute('aria-pressed', 'false');
      });
      thumb.classList.add('pd-thumb--active');
      thumb.setAttribute('aria-pressed', 'true');
    }
    thumb.addEventListener('click', activate);
    thumb.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });

  // ── Zoom on hover (CSS-based via data-zoom src swap) ───────
  var frame = document.getElementById('pd-main-frame');

  if (frame && mainImg) {
    frame.addEventListener('mouseenter', function () {
      var zoomSrc = mainImg.getAttribute('data-zoom');
      if (zoomSrc && zoomSrc !== mainImg.src) {
        // Preload zoom image
        var preload = new Image();
        preload.src = zoomSrc;
      }
    });
  }

  // ── Lightbox ────────────────────────────────────────────────
  var lightbox   = document.getElementById('pd-lightbox');
  var lbImg      = document.getElementById('pd-lightbox-img');
  var lbClose    = document.getElementById('pd-lightbox-close');
  var lbOverlay  = document.getElementById('pd-lightbox-overlay');

  function openLightbox() {
    if (!lightbox || !mainImg) return;
    var zoomSrc = mainImg.getAttribute('data-zoom') || mainImg.src;
    lbImg.src = zoomSrc;
    lbImg.alt = mainImg.alt;
    lightbox.classList.add('pd-lightbox--open');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('pd-lightbox--open');
    document.body.style.overflow = '';
    if (frame) frame.focus();
  }

  if (frame) frame.addEventListener('click', openLightbox);

  if (lbClose) lbClose.addEventListener('click', closeLightbox);
  if (lbOverlay) lbOverlay.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeLightbox();
  });

  // ── Add to cart feedback ────────────────────────────────────
  var addForm = document.getElementById('pd-add-form');
  var addBtn  = document.getElementById('pd-add-to-cart');

  if (addForm && addBtn) {
    addForm.addEventListener('submit', function () {
      if (addBtn.disabled) return;
      addBtn.classList.add('pd-add-btn--loading');
      addBtn.setAttribute('aria-busy', 'true');
      setTimeout(function () {
        addBtn.classList.remove('pd-add-btn--loading');
        addBtn.classList.add('pd-add-btn--added');
        addBtn.setAttribute('aria-busy', 'false');
        addBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Aggiunto al carrello';
        setTimeout(function () {
          addBtn.classList.remove('pd-add-btn--added');
        }, 3000);
      }, 800);
    });
  }

  // ── Live Viewers Simulator ────────────────────────────────────
  var viewersContainer = document.getElementById('pd-live-viewers');
  var viewersCount = document.getElementById('pd-live-count');
  
  if (viewersContainer && viewersCount) {
    var currentViewers = Math.floor(Math.random() * 4) + 2;
    viewersCount.innerText = currentViewers;
    viewersContainer.style.display = 'flex';
    
    setInterval(function() {
      var change = Math.floor(Math.random() * 3) - 1;
      currentViewers = currentViewers + change;
      if (currentViewers < 1) currentViewers = 1;
      if (currentViewers > 12) currentViewers = 12;
      viewersCount.innerText = currentViewers;
    }, 12000);
  }

})();
</script>

{% schema %}
{
  "name": "Dettaglio Opera",
  "settings": [
    {
      "type": "paragraph",
      "content": "La pagina prodotto legge automaticamente i metafields custom.tecnica, custom.dimensioni, custom.anno, custom.firmata, custom.incorniciata, custom.tipo, custom.franchise, custom.supporto, custom.spedizione_note."
    }
  ]
}
{% endschema %}
