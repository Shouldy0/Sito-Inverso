{% comment %}
  HERO — INverso Homepage
  Immagine full-bleed dell'opera in evidenza (es. Grifone Ribelle)
  con overlay elegante e CTA minimal.
{% endcomment %}

<section class="hp-hero" data-section-id="{{ section.id }}">

  <!-- Immagine artwork full-bleed -->
  <div class="hp-hero__media">
    {%- if section.settings.hero_image != blank -%}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        alt="{{ section.settings.hero_image_alt | default: 'Grifone Ribelle — Daiana Vaiani' }}"
        class="hp-hero__img"
        width="2400"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        src="{{ 'grifone-ribelle.png' | asset_url }}"
        alt="Grifone Ribelle — Opera originale di Daiana Vaiani"
        class="hp-hero__img"
        loading="eager"
      >
    {%- endif -%}
    <div class="hp-hero__overlay"></div>
  </div>

  <!-- Contenuto testuale -->
  <div class="hp-hero__content">
    <div class="hp-hero__inner">
      <p class="hp-hero__eyebrow">
        <span class="hp-hero__eyebrow-line"></span>
        {{ section.settings.eyebrow | default: 'Arte Originale' }}
        <span class="hp-hero__eyebrow-line"></span>
      </p>

      <h1 class="hp-hero__title">
        {%- assign title_parts = section.settings.title | default: 'INverso' | split: '—' -%}
        {%- if title_parts.size > 1 -%}
          <span class="hp-hero__title-main">{{ title_parts[0] | strip }}</span>
          <span class="hp-hero__title-sub">{{ title_parts[1] | strip }}</span>
        {%- else -%}
          {{ section.settings.title | default: 'INverso' }}
        {%- endif -%}
      </h1>

      <p class="hp-hero__artwork-credit">
        {{ section.settings.artwork_credit | default: '"Grifone Ribelle" — china su carta, 2025' }}
      </p>

      <a
        href="{{ section.settings.cta_url | default: '/collections/all' }}"
        class="hp-hero__cta"
        id="hero-cta-main"
      >
        {{ section.settings.cta_label | default: 'Scopri le opere' }}
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="hp-hero__scroll" aria-hidden="true">
    <span class="hp-hero__scroll-text">{{ section.settings.scroll_text | default: 'Scorri' }}</span>
    <span class="hp-hero__scroll-bar"></span>
  </div>

</section>

{% schema %}
{
  "name": "Hero — Opera in Evidenza",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Opera in evidenza (piena larghezza)"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Alt text immagine",
      "default": "Grifone Ribelle — Opera originale di Daiana Vaiani"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Testo sopra titolo",
      "default": "Arte Originale"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo hero (usa — per dividere in due righe)",
      "default": "INverso — Arte originale di Daiana Vaiani"
    },
    {
      "type": "text",
      "id": "artwork_credit",
      "label": "Didascalia opera",
      "default": "\"Grifone Ribelle\" — china su carta, 2025"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link bottone CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Etichetta bottone",
      "default": "Scopri le opere"
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Testo scroll hint",
      "default": "Scorri"
    },
    {
      "type": "select",
      "id": "overlay_intensity",
      "label": "Intensità overlay scuro",
      "options": [
        { "value": "light", "label": "Leggero (opera più visibile)" },
        { "value": "medium", "label": "Medio (bilanciato)" },
        { "value": "strong", "label": "Forte (testo più leggibile)" }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "Hero — Opera in Evidenza"
    }
  ]
}
{% endschema %}
