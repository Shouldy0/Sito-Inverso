{%- assign product = all_products[section.settings.featured_product] -%}

<section class="featured-hero container" data-section-id="{{ section.id }}">
  {%- if product != blank -%}
    <a href="{{ product.url }}" class="featured-image-wrapper floating-slow">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape }}" class="featured-image" loading="lazy" />
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'featured-image placeholder-svg' }}
      {%- endif -%}
    </a>
    
    <div class="featured-content reveal-3d">
      <span class="featured-label">{{ product.type }}</span>
      <a href="{{ product.url }}" style="text-decoration: none;">
        <h1 class="featured-title">{{ product.title }}</h1>
      </a>
      <p class="featured-desc">{{ product.description | strip_html | truncatewords: 60 }}</p>
      
      <div class="featured-actions">
        <span class="featured-price">{{ product.price | money }}</span>
        
        {%- form 'product', product, id: "featured-product-form", class: "featured-product-form" -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <button type="submit" class="btn btn-primary" {% unless product.available %}disabled{% endunless %}>
            <span class="btn-content">
              {%- if product.available -%}
                {%- if product.tags contains 'preorder' or product.metafields.custom.preorder -%}
                  Pre-ordina ora
                {%- else -%}
                  Aggiungi al Carrello
                {%- endif -%}
              {%- else -%}
                Esaurito
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </div>
    </div>
  {%- else -%}
    <!-- Placeholder state for Shopify theme customizer -->
    <div class="featured-image-wrapper floating-slow">
      {{ 'product-1' | placeholder_svg_tag: 'featured-image placeholder-svg' }}
    </div>
    <div class="featured-content">
      <span class="featured-label">Categoria Prodotto</span>
      <h1 class="featured-title">Titolo Prodotto in Evidenza</h1>
      <p class="featured-desc">Questa descrizione comparirà quando avrai selezionato un prodotto reale nel pannello di personalizzazione di Shopify.</p>
      <div class="featured-actions">
        <span class="featured-price">€19.99</span>
        <button class="btn btn-primary" disabled><span class="btn-content">Aggiungi al Carrello</span></button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Prodotto in Evidenza",
  "settings": [
    {
      "type": "product",
      "id": "featured_product",
      "label": "Seleziona Prodotto"
    }
  ],
  "presets": [
    {
      "name": "Prodotto in Evidenza"
    }
  ]
}
{% endschema %}
