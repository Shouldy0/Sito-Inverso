<!doctype html>
<html class="no-js" lang="it">
  <head>
  <meta name="google-site-verification" content="A7arbu8lvT7kg1XalIevXELHiYd1W45pHZwfcpND-cE" />
    <script>document.documentElement.classList.remove('no-js');</script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0a0a0c">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    {%- assign seo_title = page_title -%}
    {%- if request.page_type == 'index' -%}
      {%- assign seo_title = 'Daiana Vaiani — Libri, Stampe e Universo Creativo' -%}
    {%- endif -%}
    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Pagina {{ current_page }}{% endif -%}
      {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- assign seo_description = page_description -%}
    {%- if seo_description == blank -%}
      {%- if request.page_type == 'index' -%}
        {%- assign seo_description = 'Scopri i libri illustrati fatti a mano, stampe fine art in bianco e nero e l\'universo creativo di Daiana Vaiani.' -%}
      {%- elsif request.page_type == 'product' -%}
        {%- assign seo_description = product.description | strip_html | truncate: 155 -%}
      {%- else -%}
        {%- assign seo_description = shop.description | default: 'Universo creativo di Daiana Vaiani — libri, stampe originali, fumetti e arte.' -%}
      {%- endif -%}
    {%- endif -%}
    <meta name="description" content="{{ seo_description | escape }}">
    <meta name="keywords" content="Daiana Vaiani, libri, stampe, fumetti, arte, Noi siamo persona, universo creativo, shop">
    <meta name="author" content="Daiana Vaiani">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    
    <!-- Scripts CDN for Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"></script>
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer="defer"></script>
    
    <!-- Theme Main Script -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <!-- Popup Newsletter -->
    <script src="{{ 'newsletter-popup.js' | asset_url }}" defer="defer"></script>
    <!-- Pinterest & Google Verification -->
    <meta name="p:domain_verify" content="1f469942c389bc213c76020a6e2cce75" />
    <meta name="google-site-verification" content="duZ6OVtNXaBhRTAGFIczTv-Bpw1Zrp_qs9kz4fXe3YI" />

    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Daiana Vaiani",
        "url": "{{ shop.url }}",
        "jobTitle": "Autrice e Illustratrice",
        "sameAs": [
          "https://www.instagram.com/daianavaiani"
        ]
      }
      </script>
    {%- endif -%}
  </head>

  <body>
    <!-- Ambient Parallax background shapes (ink nebulas) -->
    <div class="ambient-glow-1 parallax-bg floating-slow" data-parallax-y="160"></div>
    <div class="ambient-glow-2 parallax-bg floating-medium" data-parallax-y="-100"></div>
    <div class="ambient-glow-3 parallax-bg floating-slow" data-parallax-y="130"></div>

    <!-- Newsletter Popup -->
    <div id="newsletter-popup" class="newsletter-popup" aria-modal="true" role="dialog" aria-labelledby="popup-title" style="display:none;">
      <div class="newsletter-popup-overlay" id="popup-overlay"></div>
      <div class="newsletter-popup-box">
        <button class="newsletter-popup-close" id="popup-close" aria-label="Chiudi popup">&times;</button>
        <div class="newsletter-popup-content">
          <div class="newsletter-popup-icon">✦</div>
          <h2 class="newsletter-popup-title" id="popup-title">Entra nell'Universo</h2>
          <p class="newsletter-popup-subtitle">Ricevi lettere dall'ombra — estratti esclusivi, dietro le quinte e accesso prioritario ai nuovi lavori.</p>
          {% form 'customer', class: 'newsletter-popup-form', id: 'popup-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,popup">
            <div class="newsletter-popup-fields">
              <input
                type="email"
                name="contact[email]"
                placeholder="La tua email..."
                class="newsletter-popup-input"
                value="{{ form.email }}"
                aria-label="Email"
                autocomplete="email"
                required
              >
              <button type="submit" class="newsletter-popup-submit">Iscriviti</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="popup-success">✓ Benvenuto nell'universo! A presto.</p>
              <script>if(window.markPopupDone) window.markPopupDone();</script>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="popup-error">Email non valida o già registrata.</p>
            {%- endif -%}
          {% endform %}
          <button class="newsletter-popup-skip" id="popup-skip">No grazie, continua a leggere</button>
        </div>
      </div>
    </div>

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cookie-banner' %}

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}'
      };
    </script>
  </body>
</html>
